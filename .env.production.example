# AMIP production environment template
# Copy to .env.production and fill real secrets locally. Never commit .env.production.

ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
HOST=0.0.0.0
PORT=8000
AMIP_PORT=8000

POSTGRES_DB=amip
POSTGRES_USER=amip
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

FFPROBE_BINARY=ffprobe
FFPROBE_TIMEOUT_SECONDS=15

# Local LLM
LLM_PROVIDER=ollama
# If Ollama runs on the Docker host, adjust this URL for the target platform/network.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=180
OPENAI_API_KEY=

# Hugging Face / pyannote diarization
# Create a read token after accepting the conditions for the configured pyannote model.
HUGGINGFACE_TOKEN=replace-with-huggingface-read-token
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_DEVICE=cpu

WHISPER_MODEL=base
WHISPER_LANGUAGE=auto
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true

STORAGE_PATH=/data/storage
MAX_UPLOAD_SIZE=500000000
LOG_LEVEL=INFO
LOG_FILE=/data/logs/app.log
