# Application
ENVIRONMENT=development
DEBUG=true
# Development placeholder only. Staging/production require a private value with >=32 characters.
SECRET_KEY=development-only-secret
HOST=0.0.0.0
PORT=8000

# Database
# Create/upgrade schema explicitly with: alembic upgrade head
DATABASE_URL=sqlite:///./app.db

# Audio inspection
FFPROBE_BINARY=ffprobe
FFPROBE_TIMEOUT_SECONDS=15

# AI Services
OPENAI_API_KEY=sk-...
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Transcription
WHISPER_MODEL=base
WHISPER_LANGUAGE=auto

# Speaker Identification
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
PYANNOTE_DEVICE=cpu

# Storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=500000000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
