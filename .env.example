# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=development-only-secret
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./app.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
# Production Compose only: never commit the real password.
POSTGRES_DB=amip
POSTGRES_USER=amip
POSTGRES_PASSWORD=
AMIP_PORT=8000

# Backup
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Audio inspection
FFPROBE_BINARY=ffprobe
# Optional. On Windows, point this to a FFmpeg Shared bin directory only if auto-discovery fails.
FFMPEG_BIN_DIR=
FFPROBE_TIMEOUT_SECONDS=15

# AI Services
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=180
# Development only: automatically starts `ollama serve` when localhost is unavailable.
OLLAMA_AUTO_START_LOCAL=true
OPENAI_API_KEY=
# Required for gated pyannote model download after accepting the model conditions.
HUGGINGFACE_TOKEN=

# Transcription
WHISPER_MODEL=base
WHISPER_LANGUAGE=auto

# Speaker diarization
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_DEVICE=cpu

# Storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=500000000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
